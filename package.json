{
  "name": "hywmusic-desktop",
  "productName": "HYWmusic",
  "version": "1.0.0-rc1",
  "description": "HYWmusic 何意味音乐 · 智能音源聚合服务桌面客户端",
  "main": "main.js",
  "author": "BennerRock",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.hywmusic.desktop",
    "productName": "HYWmusic",
    "copyright": "Copyright © 2026 BennerRock",
    "directories": {
      "output": "../version/v1.0.0-rc1",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "build/icon.ico",
      "LICENSE",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HYWmusic",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "artifactName": "HYWmusic-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HYWmusic-Portable-${version}.${ext}",
      "unpackDirName": "HYWmusic",
      "requestExecutionLevel": "user"
    },
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  }
}
